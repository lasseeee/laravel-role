{
    "name": "lasseeee/laravel-role",
    "description": "laravel-role",
    "keywords": [
        "lasseeee",
        "laravel-role"
    ],
    "homepage": "https://github.com/lasseeee/laravel-role",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.12.1",
        "illuminate/contracts": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Lasseeee\\Role\\": "src",
            "Lasseeee\\Role\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lasseeee\\Role\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lasseeee\\Role\\RoleServiceProvider"
            ],
            "aliases": {
                "Role": "Lasseeee\\Role\\RoleFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
